# Copie para .env só na máquina ou no serviço do EasyPanel.
# Nunca commite o .env. A senha do Postgres fica apenas na variável.

# Host interno do serviço p-novo-postgresql, no projeto criadordigital.
# Codifique caracteres especiais da senha (por exemplo @ vira %40).
# sslmode=disable é o esperado na rede interna do EasyPanel.
DATABASE_URL=postgres://postgres:SENHA@criadordigital_p-novo-postgresql:5432/criadordigital?sslmode=disable

# URL pública do aplicativo, sem barra no final.
# É ela que entra no link de criação de senha. Não use o host interno do banco.
APP_BASE_URL=https://precocerto.seudominio.com

# Opcional. Prazo do link de senha, em horas. Padrão: 72.
PASSWORD_TOKEN_TTL_HOURS=72

# Opcional. Duração da sessão, em dias. Padrão: 14.
SESSION_TTL_DAYS=14

# Opcional. true força o cookie Secure (somente HTTPS).
# false serve para teste local por HTTP.
# Se ficar vazio, o servidor usa X-Forwarded-Proto e, sem esse cabeçalho, Secure quando NODE_ENV=production.
COOKIE_SECURE=

# Porta HTTP. O EasyPanel normalmente injeta PORT. Padrão: 3000.
PORT=3000
NODE_ENV=production

# Opcional, alternativa aos argumentos do comando de cadastro:
# SEED_NAME=Celia Matias
# SEED_EMAIL=celiamatias46@gmail.com
